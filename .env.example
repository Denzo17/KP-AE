# Скопировать в /etc/kp-ae.env и заполнить.

PORT=3000

# Внешний адрес сайта — подставляется в ссылки на счета.
# При смене домена меняется только эта строка.
BASE_URL=https://schet.example.ru

# Каталог с данными. Держать ВНЕ каталога с кодом, иначе деплой затрёт счета.
DATA_DIR=/var/lib/kp-ae

# Системный chromium для печати PDF.
CHROMIUM_PATH=/usr/bin/chromium

# Доступ к форме и API. Страница счёта и PDF остаются публичными по ссылке.
# Без пароля сервис не стартует.
AUTH_USER=manager
AUTH_PASSWORD=

# Битрикс24 — пока не подключён.
# BITRIX_ENABLED=1
# BITRIX_WEBHOOK_URL=https://portal.bitrix24.ru/rest/1/токен/
